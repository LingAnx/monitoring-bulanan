# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ksop_laporan
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Security - JWT Secret (GENERATE dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=

# CORS - Origin yang diizinkan (comma-separated, kosong = semua untuk development)
CORS_ORIGIN=http://localhost:3000
