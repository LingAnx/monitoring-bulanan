# ============================================================
# .env.example — Sistem Monitoring Bulanan KSOP Cirebon
# Salin file ini menjadi .env lalu isi dengan nilai Anda sendiri.
# ⚠️  JANGAN commit .env yang berisi secret nyata ke Git.
# ============================================================

# ── Environment ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database Configuration ─────────────────────────────────
# DB_HOST, DB_PORT, DB_NAME: sesuaikan dengan konfigurasi PostgreSQL Anda.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monitoring_bulanan

# DB_USER: gunakan role database khusus aplikasi (bukan superuser) di production.
# Hak minimum: SELECT/INSERT/UPDATE/DELETE pada tabel terkait, USAGE pada sequence.
# Lihat: backend/docs/db-credentials.md
DB_USER=

# DB_PASSWORD: isi dengan password kuat untuk user di atas.
# Kosongkan di sini — JANGAN isi placeholder yang mungkin tanpa sengaja dipakai.
# Di production, set melalui environment deployment atau secret manager.
DB_PASSWORD=

# Neon/PostgreSQL production connections require TLS.
PGSSLMODE=require
DB_CONNECT_TIMEOUT_MS=10000

# ── Private Object Storage (S3-compatible) ──────────────────
# Required in production. Keep the bucket private; downloads are served only
# through the authenticated API. Never commit real credential values.
STORAGE_PROVIDER=s3
S3_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# ── JWT Secret ──────────────────────────────────────────────
# WAJIB diset. Tidak ada fallback. Minimum 32 karakter.
# Di production, gunakan nilai acak kuat (64 byte hex = 128 karakter):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Simpan melalui secret manager atau environment deployment, bukan di file .env
# yang ter-commit ke Git.
#
# Setelah rotasi JWT_SECRET, SEMUA token lama otomatis tidak valid.
# Seluruh pengguna aktif harus login ulang.
JWT_SECRET=

# ── Metrics & Observability ──────────────────────────────────
# /health = liveness (selalu terbuka).
# /ready  = readiness (cek DB).
# /metrics = diagnostik operator. Dilindungi dua lapis:
#   - Set METRICS_TOKEN: hanya pemanggil dengan
#     `Authorization: Bearer $METRICS_TOKEN` yang diterima
#     (dari IP mana pun — misalnya jaringan operator/monitoring).
#   - Tanpa METRICS_TOKEN: hanya IP localhost (127.0.0.1 / ::1).
# Disarankan: selalu set METRICS_TOKEN di production, lalu
# jalankan script di bawah untuk mengecek endpoint.
METRICS_TOKEN=

# ── Password Change Token TTL ────────────────────────────────
# Token SEMENTARA purpose 'password-change' (diberikan saat login
# user dengan must_change_password=true). Nilai default: 10 menit
# ('10m'). Set lebih pendek bila diinginkan (mis. '5m').
# Token ini SATU-PERGUNAAN per versi token_version dan TIDAK
# bisa dipakai di endpoint aplikasi lain (audience berbeda).
PASSWORD_CHANGE_TOKEN_TTL=

# ── CORS (opsional) ──────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Logging ─────────────────────────────────────────────────
# log level: error | warn | info | debug
LOG_LEVEL=info

# ── Seed Scripts (development only) ──────────��─────────────
# Jika menjalankan setup-seed di production, set semua variabel ini
# sebelum menjalankan: node scripts/setup-seed.js --prod
# JANGAN memakai nilai default development di production.
SEED_ADMIN_PASSWORD=
SEED_KEPALA_PASSWORD=
SEED_ADMIN_TU_PASSWORD=
SEED_ADMIN_LL_PASSWORD=
SEED_PEGAWAI_PASSWORD=
